{
  "name": "@family-trivia/api",
  "version": "0.1.0",
  "private": true,
  "description": "The Family Trivia API: one Lambda behind API Gateway",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local dev-server.ts",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@family-trivia/shared": "workspace:*",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.13",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.7",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
