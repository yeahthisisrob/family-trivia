# Local API settings (copy to .env.local, which is gitignored).
# Use a dev bucket, never the one your family plays on.
BUCKET_NAME=your-dev-data-bucket
AWS_REGION=us-east-1
AWS_PROFILE=default
# openssl rand -hex 32
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
LOG_LEVEL=INFO
