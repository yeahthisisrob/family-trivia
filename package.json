{
  "name": "family-trivia",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered family trivia, daily facts, and mini-games, built with React, AWS CDK, and Claude on Bedrock.",
  "license": "MIT",
  "author": "Rob D'Hondt",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeahthisisrob/family-trivia.git"
  },
  "homepage": "https://github.com/yeahthisisrob/family-trivia#readme",
  "bugs": {
    "url": "https://github.com/yeahthisisrob/family-trivia/issues"
  },
  "keywords": [
    "family",
    "trivia",
    "react",
    "aws-cdk",
    "bedrock",
    "claude",
    "ai"
  ],
  "scripts": {
    "dev": "just dev",
    "check": "biome check .",
    "fix": "biome check --write .",
    "deadcode": "knip --no-progress",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "contract": "pnpm --filter @family-trivia/shared run contract",
    "leaks": "node scripts/leak-guard.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "concurrently": "^10.0.6",
    "knip": "^6.42.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12"
  }
}
