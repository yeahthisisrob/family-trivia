{
  "name": "@family-trivia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_DEBUG_MODE=true vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --project=storybook",
    "storybook:test:watch": "vitest --project=storybook",
    "test:unit": "vitest run --project=unit",
    "test:unit:watch": "vitest --project=unit",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@family-trivia/shared": "workspace:*",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@mui/x-date-pickers": "^6.20.2",
    "@react-oauth/google": "^0.13.4",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.9.4",
    "fuse.js": "^7.3.0",
    "matter-js": "^0.20.0",
    "react": "^19.3.0",
    "react-confetti-explosion": "^3.0.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.15.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "msw": "^2.13.0",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.59.0",
    "storybook": "^10.3.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.20",
    "vite-plugin-checker": "^0.9.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "license": "MIT"
}
