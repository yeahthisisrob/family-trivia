{
  "name": "@family-trivia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_DEBUG_MODE=true vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --project=storybook",
    "storybook:test:watch": "vitest --project=storybook",
    "test:unit": "vitest run --project=unit",
    "test:unit:watch": "vitest --project=unit",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@family-trivia/shared": "workspace:*",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "5.108.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "fflate": "0.8.3",
    "framer-motion": "^14.14.0",
    "fuse.js": "^7.5.0",
    "matter-js": "^0.20.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-confetti-explosion": "^3.0.3",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "license": "MIT"
}
